# systemd service: starts the Python backend at boot and restarts it if it crashes
# Security: runs as the dedicated low-privilege user "toddler"; the whole filesystem is read-only for it
[Unit]
Description=Hear-a-Note API (FastAPI + uvicorn)
After=network.target

[Service]
User=toddler
Group=toddler
WorkingDirectory=__APP_DIR__
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=__APP_DIR__/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2 --no-server-header
Restart=always
RestartSec=3

# ---- Sandbox (read-only) ----
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
