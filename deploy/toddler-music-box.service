# systemd 服務：開機自動啟動 Python 後端，當掉會自動重啟
[Unit]
Description=Toddler Music Box API (FastAPI + uvicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
